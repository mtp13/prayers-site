---
interface NavLink {
  href: string;
  title: string;
}

interface Props {
  previous: NavLink | null;
  next: NavLink | null;
  label: string;
}

const { previous, next, label } = Astro.props;
---

<nav class="page-nav" aria-label={label}>
  {previous && (
    <a class="page-nav-link page-nav-link--prev" href={previous.href} rel="prev">
      <span class="page-nav-label">‹ Previous</span>
      <span class="page-nav-title">{previous.title}</span>
    </a>
  )}
  {next && (
    <a class="page-nav-link page-nav-link--next" href={next.href} rel="next">
      <span class="page-nav-label">Next ›</span>
      <span class="page-nav-title">{next.title}</span>
    </a>
  )}
</nav>

<script>
  // Swipe left for the next page and right for the previous one, using the same links as the bar.
  // Touches that start at the screen edge are ignored so Safari's own back/forward swipe still works.
  const EDGE = 24;
  const MIN_DISTANCE = 60;
  const MAX_DURATION = 600;

  let start: { x: number; y: number; time: number } | null = null;
  let last = { x: 0, y: 0 };

  document.addEventListener(
    'touchstart',
    (event) => {
      const touch = event.touches[0];
      const zoomed = (window.visualViewport?.scale ?? 1) > 1.01;
      const atEdge = touch.clientX < EDGE || touch.clientX > window.innerWidth - EDGE;
      start = event.touches.length === 1 && !zoomed && !atEdge
        ? { x: touch.clientX, y: touch.clientY, time: Date.now() }
        : null;
      last = { x: touch.clientX, y: touch.clientY };
    },
    { passive: true },
  );

  document.addEventListener(
    'touchmove',
    (event) => {
      if (event.touches.length > 1) start = null;
      last = { x: event.touches[0].clientX, y: event.touches[0].clientY };
    },
    { passive: true },
  );

  function finishSwipe() {
    if (!start) return;
    const dx = last.x - start.x;
    const dy = last.y - start.y;
    const quick = Date.now() - start.time < MAX_DURATION;
    start = null;

    const horizontal = Math.abs(dx) >= MIN_DISTANCE && Math.abs(dy) < Math.abs(dx) / 2;
    if (!quick || !horizontal || window.getSelection()?.toString()) return;

    const link = document.querySelector<HTMLAnchorElement>(`.page-nav [rel="${dx < 0 ? 'next' : 'prev'}"]`);
    if (link) window.location.href = link.href;
  }

  document.addEventListener('touchend', finishSwipe, { passive: true });
  // A cancelled touch was interrupted by the browser or system, so it never counts as a swipe.
  document.addEventListener('touchcancel', () => { start = null; }, { passive: true });
</script>
