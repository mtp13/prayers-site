---
import { getEntry, render } from 'astro:content';

// The prayers of one decade, shown in place so the reader never leaves the mystery.
const items = [
  { id: 'our_father', label: 'Our Father' },
  { id: 'hail_mary', label: 'Hail Mary', count: '10×' },
  { id: 'glory_be', label: 'Glory Be' },
  { id: 'fatima_prayer', label: 'Fatima Prayer' },
];

const prayers = await Promise.all(
  items.map(async (item) => {
    const entry = await getEntry('prayers', item.id);
    if (!entry) {
      throw new Error(`Missing prayer "${item.id}" for the decade`);
    }
    const { Content } = await render(entry);
    return { ...item, Content };
  }),
);
---

<section class="decade" aria-labelledby="decade-heading">
  <h2 id="decade-heading">Pray the decade</h2>
  {prayers.map(({ label, count, Content }) => (
    <details class="decade-prayer">
      <summary>
        <span>{label}</span>
        {count && <span class="decade-count">{count}</span>}
      </summary>
      <div class="decade-prayer-text">
        <Content />
      </div>
    </details>
  ))}
</section>
