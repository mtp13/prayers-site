---
import type { MysteryPageMeta, MysterySetSlug } from '../lib/rosary-mysteries';

interface Props {
  setSlug: MysterySetSlug;
  previous: MysteryPageMeta | null;
  next: MysteryPageMeta | null;
  position?: 'top' | 'bottom';
}

const { setSlug, previous, next, position = 'top' } = Astro.props;
const setUrl = `${import.meta.env.BASE_URL}/mysteries/${setSlug}`;
---

<div class:list={['mystery-nav', { 'mystery-nav--bottom': position === 'bottom' }]}>
  {previous ? (
    <a class="mystery-nav-link" href={`${setUrl}/${previous.slug}`}>
      ← Previous: {previous.title}
    </a>
  ) : (
    <span class="mystery-nav-link is-disabled" aria-disabled="true">← Previous</span>
  )}

  {next ? (
    <a class="mystery-nav-link" href={`${setUrl}/${next.slug}`}>
      Next: {next.title} →
    </a>
  ) : (
    <span class="mystery-nav-link is-disabled" aria-disabled="true">Next →</span>
  )}
</div>
