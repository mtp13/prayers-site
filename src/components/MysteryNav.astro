---
import type { MysteryPageMeta, MysterySetSlug } from '../lib/rosary-mysteries';

interface Props {
  setSlug: MysterySetSlug;
  current: MysteryPageMeta;
  previous: MysteryPageMeta | null;
  next: MysteryPageMeta | null;
  position?: 'top' | 'bottom';
}

const { setSlug, current, previous, next, position = 'top' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const setUrl = `${baseUrl}/mysteries/${setSlug}`;

// After the fifth mystery the Rosary continues with the Hail Holy Queen, then the closing prayer.
const back = `back=${encodeURIComponent(`${setUrl}/${current.slug}`)}&backLabel=${encodeURIComponent(current.title)}`;
const hailHolyQueenHref = `${baseUrl}/prayers/hail_holy_queen?${back}`;
---

<nav
  class:list={['mystery-nav', { 'mystery-nav--bottom': position === 'bottom' }]}
  aria-label={position === 'bottom' ? 'Mystery navigation (bottom)' : 'Mystery navigation'}
>
  {previous && (
    <a class="mystery-nav-link mystery-nav-link--prev" href={`${setUrl}/${previous.slug}`} rel="prev">
      <span class="mystery-nav-label">← Previous</span>
      <span class="mystery-nav-title">{previous.title}</span>
    </a>
  )}

  <a
    class="mystery-nav-link mystery-nav-link--next"
    href={next ? `${setUrl}/${next.slug}` : hailHolyQueenHref}
    rel={next ? 'next' : undefined}
  >
    <span class="mystery-nav-label">Next →</span>
    <span class="mystery-nav-title">{next ? next.title : 'Hail Holy Queen'}</span>
  </a>
</nav>
