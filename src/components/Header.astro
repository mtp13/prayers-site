---
import { getPrayerGroups, getSortedCollection } from '../lib/collections';

const baseUrl = import.meta.env.BASE_URL;

const prayerGroups = await getPrayerGroups();
const sortedMysteries = await getSortedCollection('mysteries');

// Appearance setting: Auto follows the system light/dark setting.
const themes = [
  { value: 'auto', label: 'Auto' },
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
];
---

<header class="site-header" role="banner">
  <div class="wrapper">
    <a class="site-title" href={baseUrl}>
      <!-- A cross ringed by rosary beads: the favicon's mark (public/favicon.svg) without its tile. -->
      <svg
        class="site-logo"
        width="21"
        height="26"
        viewBox="9 4 46 56"
        xmlns="http://www.w3.org/2000/svg"
        fill="currentColor"
        aria-hidden="true"
      >
        <rect x="29" y="4" width="6" height="56" rx="1.5" />
        <rect x="9" y="21" width="46" height="6" rx="1.5" />
        <circle cx="45" cy="31.5" r="2.8" />
        <circle cx="39.5" cy="37" r="2.8" />
        <circle cx="24.5" cy="37" r="2.8" />
        <circle cx="19" cy="31.5" r="2.8" />
        <circle cx="19" cy="16.5" r="2.8" />
        <circle cx="24.5" cy="11" r="2.8" />
        <circle cx="39.5" cy="11" r="2.8" />
        <circle cx="45" cy="16.5" r="2.8" />
      </svg>
      <span class="site-title-text">Rosary Prayers</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
      <span>Menu</span>
      <span class="menu-icon" aria-hidden="true">
        ☰
      </span>
    </button>
  </div>

  <nav class="site-menu" id="site-menu" aria-label="Site" hidden>
    <div class="wrapper site-menu-columns">
      <section>
        <h2 class="site-menu-heading">Mysteries</h2>
        <a href={baseUrl}>Today's Mystery</a>
        {sortedMysteries.map((mystery) => (
          <a href={`${baseUrl}/mysteries/${mystery.id}`}>{mystery.data.title}</a>
        ))}
      </section>
      {prayerGroups.map((group) => (
        <section>
          <h2 class="site-menu-heading">{group.title}</h2>
          {group.prayers.map((prayer) => (
            <a href={`${baseUrl}/prayers/${prayer.id}`}>{prayer.data.title}</a>
          ))}
        </section>
      ))}
    </div>
    <div class="wrapper site-menu-appearance">
      <fieldset class="theme-picker">
        <legend class="site-menu-heading">Appearance</legend>
        <div class="theme-options">
          {themes.map(({ value, label }) => (
            <label>
              <input type="radio" name="theme" value={value} checked={value === 'auto'} />
              <span>{label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    </div>
  </nav>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = document.getElementById('site-menu');

    function setOpen(open: boolean) {
      if (!toggle || !menu) return;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) {
        // Place the fixed menu just below the header, wherever the header is on screen.
        const headerBottom = toggle.closest('.site-header')?.getBoundingClientRect().bottom ?? 70;
        menu.style.setProperty('--menu-top', `${Math.max(0, headerBottom)}px`);
      }
      menu.hidden = !open;
      // Lock the page behind the menu so a drag doesn't scroll both.
      document.documentElement.classList.toggle('menu-open', open);
    }

    toggle?.addEventListener('click', () => setOpen(menu?.hidden === true));

    // Appearance: BaseHead.astro applies the saved choice on load; this keeps the radios and page in step with it.
    const themeColors = { light: '#FFFBF5', dark: '#1C1512' };

    function applyTheme(theme: string) {
      const root = document.documentElement;
      const explicit = theme === 'light' || theme === 'dark';
      if (explicit) root.dataset.theme = theme;
      else delete root.dataset.theme;
      document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')!.content = explicit ? theme : 'light dark';
      // The browser bar color: the chosen theme's, or per system scheme for Auto.
      for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
        const scheme = explicit ? theme : meta.media.includes('dark') ? 'dark' : 'light';
        meta.content = themeColors[scheme];
      }
      try {
        if (explicit) localStorage.setItem('theme', theme);
        else localStorage.removeItem('theme');
      } catch {
        // Storage blocked: the choice applies to this page only.
      }
    }

    const savedTheme = document.documentElement.dataset.theme ?? 'auto';
    for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="theme"]')) {
      radio.checked = radio.value === savedTheme;
      radio.addEventListener('change', () => applyTheme(radio.value));
    }

    document.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (!target.closest('.site-menu') && !target.closest('.menu-toggle')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
        toggle?.focus();
      }
    });
  </script>
</header>
