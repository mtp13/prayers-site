---
import BaseLayout from '../layouts/BaseLayout.astro';
import MysteryCard from '../components/MysteryCard.astro';
import { getSortedCollection } from '../lib/collections';

const baseUrl = import.meta.env.BASE_URL;

const sortedPrayers = await getSortedCollection('prayers');
const sortedMysteries = await getSortedCollection('mysteries');
---

<BaseLayout title="Rosary Prayers" description="A collection of prayers for the Holy Rosary">
  <section>
    <h2>Today's Mystery</h2>
    <MysteryCard />
  </section>

  <section>
    <h2>Prayers</h2>
    <ul>
      {sortedPrayers.map((prayer) => (
        <li><a href={`${baseUrl}/prayers/${prayer.id}`}>{prayer.data.title}</a></li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Mysteries</h2>
    <ul>
      {sortedMysteries.map((mystery) => (
        <li><a href={`${baseUrl}/mysteries/${mystery.id}`}>{mystery.data.title}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
