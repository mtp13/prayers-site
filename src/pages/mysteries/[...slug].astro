---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DecadePrayers from '../../components/DecadePrayers.astro';
import PageNav from '../../components/PageNav.astro';
import {
  getMysteryLabel,
  getMysteryNavigation,
  getMysterySectionHtml,
  mysterySetOrder,
  mysterySets,
  type MysterySetSlug,
} from '../../lib/rosary-mysteries';

export async function getStaticPaths() {
  return mysterySetOrder.flatMap((setSlug) => {
    const set = mysterySets[setSlug];

    return [
      {
        params: { slug: setSlug },
        props: { kind: 'overview', setSlug },
      },
      ...set.pages.map((page, pageIndex) => ({
        params: { slug: `${setSlug}/${page.slug}` },
        props: { kind: 'detail', setSlug, pageIndex },
      })),
    ];
  });
}

const { kind, setSlug, pageIndex = 0 } = Astro.props as {
  kind: 'overview' | 'detail';
  setSlug: MysterySetSlug;
  pageIndex?: number;
};

const baseUrl = import.meta.env.BASE_URL;
const set = mysterySets[setSlug];
const setUrl = `${baseUrl}/mysteries/${setSlug}`;
const setName = set.title.replace(/^The /, '');
const page = set.pages[pageIndex];
const pageUrl = (slug: string) => `${setUrl}/${slug}`;

const sectionHtml = kind === 'detail' ? await getMysterySectionHtml(setSlug, pageIndex) : '';
const { previous, next } = getMysteryNavigation(setSlug, pageIndex);

// After the fifth mystery the Rosary continues with the Hail Holy Queen, then the closing prayer.
const nav = kind === 'overview'
  ? { previous: null, next: { href: pageUrl(page.slug), title: page.title } }
  : {
    previous: previous ? { href: pageUrl(previous.slug), title: previous.title } : null,
    next: next
      ? { href: pageUrl(next.slug), title: next.title }
      : { href: `${baseUrl}/prayers/hail_holy_queen`, title: 'Hail Holy Queen' },
  };
---

<BaseLayout title={kind === 'overview' ? set.title : page.title}>
  <article class="mystery">
    {kind === 'overview' ? (
      <>
        <h1>{set.title}</h1>
        <p class="mystery-overview-days">
          Traditionally prayed on {set.days.join(' and ')}.
          {set.note && <br />}
          {set.note}
        </p>

        <ol class="mystery-overview-list">
          {set.pages.map((overviewPage, index) => (
            <li>
              <a href={pageUrl(overviewPage.slug)}>
                <span class="mystery-overview-label">{getMysteryLabel(setSlug, index)}</span>
                <span class="mystery-overview-title">{overviewPage.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </>
    ) : (
      <>
        <header class="mystery-header">
          <p class="page-eyebrow">
            <a href={setUrl}>{setName}</a> · {pageIndex + 1} of {set.pages.length}
          </p>
          <ol class="mystery-progress" aria-hidden="true">
            {set.pages.map((_, index) => (
              <li class:list={{ 'is-done': index < pageIndex, 'is-current': index === pageIndex }} />
            ))}
          </ol>
          <h1>{page.title}</h1>
          <p class="mystery-label">{getMysteryLabel(setSlug, pageIndex)}</p>
        </header>

        <div class="mystery-content" set:html={sectionHtml} />

        <DecadePrayers />
      </>
    )}

    <PageNav previous={nav.previous} next={nav.next} label="Mysteries" />
  </article>
</BaseLayout>
