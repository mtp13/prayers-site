---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNav from '../../components/PageNav.astro';
import PrayerSequence, { type PrayerItem } from '../../components/PrayerSequence.astro';
import { getPrayerGroups } from '../../lib/collections';
import {
  getMysteryLabel,
  getMysterySectionHtml,
  getMysterySteps,
  mysterySetOrder,
  mysterySets,
  type MysterySetSlug,
  type MysteryStep,
} from '../../lib/rosary-mysteries';

export async function getStaticPaths() {
  return mysterySetOrder.flatMap((setSlug) => [
    { params: { slug: setSlug }, props: { setSlug, stepIndex: -1 } },
    ...getMysterySteps(setSlug).map((step, stepIndex) => ({
      params: { slug: `${setSlug}/${step.slug}` },
      props: { setSlug, stepIndex },
    })),
  ]);
}

const { setSlug, stepIndex } = Astro.props as { setSlug: MysterySetSlug; stepIndex: number };

const baseUrl = import.meta.env.BASE_URL;
const set = mysterySets[setSlug];
const setUrl = `${baseUrl}/mysteries/${setSlug}`;
const setName = set.title.replace(/^The /, '');
const steps = getMysterySteps(setSlug);
const step = steps[stepIndex]; // undefined on the overview page
const stepLink = (s: MysteryStep) => ({ href: `${setUrl}/${s.slug}`, title: s.title });

const openingPrayers: PrayerItem[] = [
  { id: 'sign_of_the_cross', label: 'Sign of the Cross' },
  { id: 'apostles_creed', label: "Apostles' Creed" },
  { id: 'our_father', label: 'Our Father' },
  { id: 'hail_mary', label: 'Hail Mary', count: '3×' },
  { id: 'glory_be', label: 'Glory Be' },
];
const decadePrayers: PrayerItem[] = [
  { id: 'our_father', label: 'Our Father' },
  { id: 'hail_mary', label: 'Hail Mary', count: '10×' },
  { id: 'glory_be', label: 'Glory Be' },
  { id: 'fatima_prayer', label: 'Fatima Prayer' },
];
const concludingPrayers: PrayerItem[] = [
  { id: 'hail_holy_queen', label: 'Hail Holy Queen', titled: false },
  { id: 'rosary_closing_prayer', label: 'Rosary Closing Prayer' },
  { id: 'sign_of_the_cross', label: 'Sign of the Cross' },
];

// The concluding page offers the prayers the St. Henry Rosary group says after the Rosary.
const afterRosary = (await getPrayerGroups()).find((group) => group.category === 'after-rosary');

const sectionHtml = step?.kind === 'mystery' ? await getMysterySectionHtml(setSlug, step.index) : '';

const eyebrow = !step
  ? ''
  : step.kind === 'mystery'
    ? `${step.index + 1} of ${set.pages.length}`
    : step.kind === 'opening'
      ? 'Opening'
      : 'Conclusion';

const previousStep = step ? steps[stepIndex - 1] : undefined;
const nextStep = step ? steps[stepIndex + 1] : steps[0];
const nav = {
  previous: previousStep ? stepLink(previousStep) : step ? { href: setUrl, title: set.title } : null,
  next: nextStep
    ? { ...stepLink(nextStep), label: step ? undefined : 'Begin' }
    : { href: setUrl, title: set.title, label: 'Finish Rosary' },
};
---

<BaseLayout title={step ? `${step.title} · ${set.title}` : set.title}>
  <article class="mystery">
    {!step ? (
      <>
        <h1>{set.title}</h1>
        <p class="mystery-overview-days">
          Traditionally prayed on {set.days.join(' and ')}.{set.note && <br />}
          {set.note}
        </p>

        <ol class="mystery-overview-list">
          {steps.map((overviewStep) => (
            <li class:list={{ 'is-bookend': overviewStep.kind !== 'mystery' }}>
              <a href={`${setUrl}/${overviewStep.slug}`}>
                {overviewStep.kind === 'mystery' && (
                  <span class="mystery-overview-label">{getMysteryLabel(setSlug, overviewStep.index)}</span>
                )}
                <span class="mystery-overview-title">{overviewStep.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </>
    ) : (
      <>
        <header class="mystery-header">
          <p class="page-eyebrow">
            <a href={setUrl}>{setName}</a> · {eyebrow}
          </p>
          <ol class="mystery-progress" aria-hidden="true">
            {steps.map((progressStep, index) => (
              <li
                class:list={{
                  'is-bookend': progressStep.kind !== 'mystery',
                  'is-done': index < stepIndex,
                  'is-current': index === stepIndex,
                }}
              />
            ))}
          </ol>
          <h1>{step.title}</h1>
          {step.kind === 'mystery' && <p class="mystery-label">{getMysteryLabel(setSlug, step.index)}</p>}
        </header>

        {step.kind === 'opening' && <PrayerSequence items={openingPrayers} expanded />}

        {step.kind === 'mystery' && (
          <>
            <div class="mystery-content" set:html={sectionHtml} />
            <PrayerSequence heading="Pray the decade" items={decadePrayers} />
          </>
        )}

        {step.kind === 'conclusion' && (
          <>
            <PrayerSequence items={concludingPrayers} expanded />
            <p class="rosary-complete">The Rosary is complete.</p>
            {afterRosary && afterRosary.prayers.length > 0 && (
              <section class="continue-card" aria-labelledby="continue-heading">
                <h2 id="continue-heading">Optional: Prayers After the Rosary</h2>
                <p>
                  The Rosary group at St. Henry Catholic Church continues with these prayers:{' '}
                  {afterRosary.prayers.map((prayer) => prayer.data.title.replace(/^The /, '')).join(', ')}.
                </p>
                <a class="continue-button" href={`${baseUrl}/prayers/${afterRosary.prayers[0].id}`}>
                  Continue with the St. Henry Prayers
                </a>
              </section>
            )}
          </>
        )}
      </>
    )}

    <PageNav previous={nav.previous} next={nav.next} label={set.title} />
  </article>
</BaseLayout>
