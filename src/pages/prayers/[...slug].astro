---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNav from '../../components/PageNav.astro';
import { getSortedCollection } from '../../lib/collections';

export async function getStaticPaths() {
  const sortedPrayers = await getSortedCollection('prayers');

  return sortedPrayers.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previousPrayer: sortedPrayers[index - 1] ?? null,
      nextPrayer: sortedPrayers[index + 1] ?? null,
    },
  }));
}

const { entry, previousPrayer, nextPrayer } = Astro.props;
const { Content } = await render(entry);
const baseUrl = import.meta.env.BASE_URL;
const link = (prayer: typeof entry | null) =>
  prayer ? { href: `${baseUrl}/prayers/${prayer.id}`, title: prayer.data.title } : null;
---

<BaseLayout title={entry.data.title}>
  <article class="prayer">
    <h1>{entry.data.title}</h1>

    <Content />

    <PageNav previous={link(previousPrayer)} next={link(nextPrayer)} label="Prayers" />
  </article>
</BaseLayout>
