---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNav from '../../components/PageNav.astro';
import { getPrayerGroups } from '../../lib/collections';

// Previous/next stay within a group, so the Rosary prayers end at the closing prayer.
export async function getStaticPaths() {
  const groups = await getPrayerGroups();

  return groups.flatMap(({ prayers }) =>
    prayers.map((entry, index) => ({
      params: { slug: entry.id },
      props: {
        entry,
        previousPrayer: prayers[index - 1] ?? null,
        nextPrayer: prayers[index + 1] ?? null,
      },
    })),
  );
}

const { entry, previousPrayer, nextPrayer } = Astro.props;
const { Content } = await render(entry);
const baseUrl = import.meta.env.BASE_URL;
const link = (prayer: typeof entry | null) =>
  prayer ? { href: `${baseUrl}/prayers/${prayer.id}`, title: prayer.data.title } : null;
---

<BaseLayout title={entry.data.title}>
  <article class="prayer">
    <h1>{entry.data.title}</h1>

    <Content />

    <PageNav previous={link(previousPrayer)} next={link(nextPrayer)} label="Prayers" />
  </article>
</BaseLayout>
