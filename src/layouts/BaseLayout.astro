---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import CopyrightNotice from '../components/CopyrightNotice.astro';
import { commitDateIso, commitSha } from '../lib/build-info';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const commitDate = commitDateIso ? new Date(commitDateIso) : null;
const formattedCommitDate = commitDate
  ? commitDate.toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })
  : 'Unknown';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main class="page-content" aria-label="Content">
      <div class="wrapper">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrapper">
        <p class="footer-line">
          Scripture texts: <em>New American Bible, revised edition</em> ·
          <a href={`${import.meta.env.BASE_URL}/copyright`} data-copyright-open>Copyright notice</a>
        </p>
        <p class="footer-line">
          Built with <a href="https://astro.build">Astro</a> · Build:
          <time datetime={commitDateIso || undefined}>{formattedCommitDate}</time> ·
          Commit: <code>{commitSha}</code>
        </p>
      </div>
    </footer>

    <dialog class="copyright-dialog" id="copyright-dialog" aria-labelledby="copyright-dialog-title">
      <h2 id="copyright-dialog-title" tabindex="-1">Copyright</h2>
      <CopyrightNotice />
      <button type="button" class="copyright-close" data-copyright-close>Close</button>
    </dialog>

    <script>
      // Show the copyright notice in a pop-up instead of navigating; the link still works without JavaScript.
      const dialog = document.getElementById('copyright-dialog') as HTMLDialogElement | null;

      if (dialog && typeof dialog.showModal === 'function') {
        document.querySelector('[data-copyright-open]')?.addEventListener('click', (event) => {
          event.preventDefault();
          dialog.showModal();
          // Start at the title rather than on the Close button, so it doesn't open with a focus ring.
          dialog.querySelector<HTMLElement>('#copyright-dialog-title')?.focus();
        });
        dialog.querySelector('[data-copyright-close]')?.addEventListener('click', () => dialog.close());
        // A tap on the backdrop (outside the box) closes it too; Escape is handled by the browser.
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });
      }
    </script>
  </body>
</html>
