{
  "name": "rosary-prayers",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "preview:host": "astro preview --host",
    "test:links": "sh scripts/test-links.sh",
    "test:csp": "node scripts/check-csp.mjs",
    "test": "npm run lint && npm run format:check && npm run check && npm run test:unit && npm run build && npm run test:csp && npm run test:links",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "astro": "astro",
    "lint": "markdownlint \"**/*.md\" --config .markdownlint.json --ignore node_modules --ignore test-results --ignore playwright-report",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.4",
    "@fontsource-variable/lora": "^5.3.0",
    "astro": "^7.4.0",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "linkinator": "^7.6.1",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  },
  "engines": {
    "node": "24.x"
  }
}
