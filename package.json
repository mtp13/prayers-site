{
  "name": "rosary-prayers",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "preview:host": "astro preview --host",
    "test:links": "sh scripts/test-links.sh",
    "test": "npm run lint && npm run build && npm run test:links",
    "astro": "astro",
    "lint": "markdownlint \"**/*.md\" --config .markdownlint.json --ignore node_modules"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.4",
    "@fontsource-variable/lora": "^5.3.0",
    "astro": "^7.4.0",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "linkinator": "^7.6.1",
    "markdownlint-cli": "^0.49.1"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
