{
  "name": "prayers-new",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "preview:host": "astro preview --host",
    "test:links": "start-server-and-test preview http://localhost:4321/rosary/ 'linkinator http://localhost:4321/rosary/ --recurse --silent --concurrency 10'",
    "test": "npm run lint && npm run build && npm run test:links",
    "astro": "astro",
    "lint": "markdownlint \"**/*.md\" --config .markdownlint.json --ignore node_modules"
  },
  "dependencies": {
    "astro": "^5.16.11",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "linkinator": "^7.6.1",
    "markdownlint-cli": "^0.49.1",
    "start-server-and-test": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  }
}
